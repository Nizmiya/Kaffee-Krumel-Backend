MONGO_URI=mongodb://localhost:27017/kaffee-krumel
PORT=5000
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production
ALLOWED_ORIGINS=http://localhost:3000
NODE_ENV=development

# Mail (Resend API) — used for consumer OTP delivery
MAIL_ENABLED=true
MAIL_TIMEOUT=30000
RESEND_API_KEY=your_resend_api_key_here
MAIL_FROM_NAME=Kaffee Krümel
MAIL_FROM_EMAIL=noreply@kaffee-krumel.com
MAIL_REPLY_TO=support@kaffee-krumel.com

# Cloudflare R2 (S3-compatible) — profile image storage
R2_BUCKET=kaffee-krumel
R2_ACCESS_KEY=your_r2_access_key_id
R2_SECRET_KEY=your_r2_secret_access_key
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://<your-public-bucket-domain>

# Social login (consumer app)
# GOOGLE_CLIENT_ID: comma-separated list of accepted audiences — include the
# Web client ID (used by expo-auth-session) and any native client IDs.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
# APPLE_CLIENT_ID: the app's bundle identifier (native Sign in with Apple
# uses the bundle ID as the token audience, not a Services ID).
APPLE_CLIENT_ID=com.kaffeekrumel.app

# Stripe (consumer checkout)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Platform Stripe fallback — used only if a branch has no StripeKeys record
# of its own (see /api/stripe-keys). Branches normally have their own
# Stripe account so their payments go directly to them.
